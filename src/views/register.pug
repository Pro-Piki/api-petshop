html
  head
    title Registro
  body
    h1 Crear cuenta

    form(action="/panel/register", method="POST")
      input(type="text", name="username", placeholder="Usuario", required)
      input(type="password", name="password", placeholder="Contraseña", required)
      select(name="role", required)
        option(value="" disabled selected) Seleccionar rol
        option(value="Admin") Admin
        option(value="Empleado") Empleado
        option(value="Profesional") Profesional
        option(value="Cliente") Cliente
      button(type="submit") Registrarse
      a(href="/panel", style="display:block; margin-top:15px;") Volver al panel
