html
  head
    title Registro usuario
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="icon" href="/images/logoHuellita.ico" type="image/x-icon")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel")
          i.fas.fa-th
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i(class="fas fa-door-open")
        <span id="contador" class="text-black ml-3" style="color: white;">Usuarios conectados: 0</span>

    .form-container
      h1 Crear cuenta

      form.registration-form(action="/panel/register", method="POST")
        input.input-field(type="text", name="username", placeholder="Usuario", required)
        input.input-field(type="password", name="password", placeholder="Contraseña", required)

        select.input-field(name="role", required)
          option(value="" disabled selected) Seleccionar rol
          option(value="Admin") Admin
          option(value="Empleado") Empleado
          option(value="Profesional") Profesional
          option(value="Cliente") Cliente

        button.button(type="submit") Registrarse
  script(src="/socket.io/socket.io.js")
  script.
    const socket = io();
    socket.on('usuarios', (cantidad) => {
      const contador = document.getElementById('contador');
      if (contador) {
        contador.textContent = 'Usuarios conectados: ' + cantidad;
      }
    });