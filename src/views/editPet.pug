doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Editar Mascota
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/turnos.css")
    link(rel="stylesheet", href="/styles/productos.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")

  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel")
          i.fas.fa-th
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i.fas.fa-door-open

    .container
      h1 Editar Mascota
      hr.linea-decorativa

      form(method="POST", action=`/pets/edit/${pet._id}`)
        .form-group
          label(for="name") Nombre de la mascota:
          input#name(type="text", name="name", required, value=pet.name)

        .form-group
          label(for="type") Tipo de mascota:
          input#type(type="text", name="type", required, value=pet.type)

        .form-group
          label(for="ownerDni") Documento del dueño:
          input#ownerDni(type="text", name="ownerDni", required, value=pet.ownerDni)

        .form-group
          label(for="ownerName") Nombre del dueño:
          input#ownerName(type="text", name="ownerName", required, value=pet.ownerName)

        button.button(type="submit") Actualizar Mascota
        a.button3(href="/pets/register") Cancelar
