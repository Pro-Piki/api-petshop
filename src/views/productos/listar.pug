extends ../layouts/main

block content
  h1.mb-4= title
  
  a.btn.btn-primary.mb-3(href="/productos/crear") Nuevo Producto
  
  table.table.table-striped
    thead
      tr
        th Nombre
        th Categoría
        th Tipo Mascota
        th Precio
        th Stock
        th Acciones
    tbody
      each product in products
        tr
          td= product.nombre
          td= product.categoria
          td= product.tipoMascota
          td= product.precio
          td= product.stock
          td
            a.btn.btn-sm.btn-info.me-1(href=`/productos/${product.id}`) Ver
            a.btn.btn-sm.btn-warning.me-1(href=`/productos/${product.id}/editar`) Editar
            form.d-inline(method="POST", action=`/productos/${product.id}?_method=DELETE`)
              button.btn.btn-sm.btn-danger(type="submit") Eliminar