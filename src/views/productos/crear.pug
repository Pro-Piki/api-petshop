doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Crear Producto
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/turnos.css")
    link(rel="icon" href="/images/logoHuellita.ico" type="image/x-icon")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel")
          i(class="fas fa-th")
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i(class="fas fa-door-open")
        <span id="contador" class="text-black ml-3" style="color: white;">Usuarios conectados: 0</span>

    .container
      h1 Crear Producto

      if errorMessage
        .error= errorMessage

      form(method="POST", action="/productos/crear")
        .form-group
          label(for="nombre") Nombre:
          input#nombre(type="text", name="nombre", required)

        .form-group
          label(for="categoria") Categoría:
          input#categoria(type="text", name="categoria", required)

        .form-group
          label(for="tipoMascota") Tipo de Mascota:
          input#tipoMascota(type="text", name="tipoMascota", required)

        .form-group-horizontal
          .half-group
            label(for="precio") Precio:
            input#precio(type="number", name="precio", step="0.01", required)

          .half-group
            label(for="stock") Stock:
            input#stock(type="number", name="stock", required)

        button.button(type="submit") Crear Producto
        a.button3(href="/productos") Volver
  script(src="/socket.io/socket.io.js")
  script.
    const socket = io();
    socket.on('usuarios', (cantidad) => {
      const contador = document.getElementById('contador');
      if (contador) {
        contador.textContent = 'Usuarios conectados: ' + cantidad;
      }
    });
