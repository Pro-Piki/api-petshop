doctype html
html
  head
    title Registro de Mascota
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel")
          i.fas.fa-th
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i.fas.fa-door-open

    .container
      .header-flex
        h1 Mascotas
        .btn-group
          button.button#openModal(type="button") Agregar Mascota
          a.button-secondary(href="/owners/register") Agregar Cliente

      if successMessage
        p.success #{successMessage}

      if errorMessage
        p.error #{errorMessage}

      if pets && pets.length
        table.custom-table
          thead
            tr
              th ID
              th Nombre de la mascota
              th Tipo de mascota
              th Documento del Dueño
              th Nombre del Dueño
              th Acciones
          tbody
            each pet in pets
              tr
                td= pet._id
                td= pet.name
                td= pet.type
                td= pet.ownerDni
                td= pet.ownerName

                td.actions
                  a(href=`/pets/details/${pet._id}`, title="Detalles", class="icon-btn detalle")
                    i.fas.fa-search
                  a(href=`/pets/edit/${pet._id}`, title="Editar", class="icon-btn editar")
                    i.fas.fa-pen
                  a(href=`/pets/delete/${pet._id}`, title="Eliminar", class="icon-btn eliminar")
                    i.fas.fa-trash

    #modal.modal
      .modal-content
        span#closeModal.close ×
        h2 Nueva Mascota

        form(action="/pets/register", method="POST")
          div
            label(for="name") Nombre de la mascota:
            input(type="text", name="name", required)

          div
            label(for="type") Tipo de mascota:
            input(type="text", name="type", required)

          div
            label(for="ownerDni") Documento del dueño:
            input(type="text", name="ownerDni", required)

          div
            label(for="ownerName") Nombre del dueño:
            input(type="text", name="ownerName", required)

          button(type="submit") Registrar Mascota

    script.
      const openModal = document.getElementById('openModal');
      const closeModal = document.getElementById('closeModal');
      const modal = document.getElementById('modal');

      openModal.addEventListener('click', () => {
        modal.style.display = 'flex';
      });

      closeModal.addEventListener('click', () => {
        modal.style.display = 'none';
      });

      window.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.style.display = 'none';
        }
      });

    script.
      const deleteButtons = document.querySelectorAll('.icon-btn.eliminar');
      deleteButtons.forEach(btn => {
        btn.addEventListener('click', function (e) {
          if (!confirm('¿Estás seguro de que deseas eliminar a esta mascota?')) {
            e.preventDefault();
          }
        });
      });