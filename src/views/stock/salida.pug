doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Salida de Stock
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/turnos.css")
    link(rel="stylesheet", href="/styles/productos.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel" title="Ir al Panel")
          i(class="fas fa-th")
        a.logout-icon(href="#" title="Cerrar sesión")
          i(class="fas fa-door-open")

    .container
      h1 Salida de Stock

      if errorMessage
        .error= errorMessage

      form(method="POST", action="/stock/salida")
        .form-group
          label(for="idProducto") Producto
          select(name="idProducto" id="idProducto" required)
            option(value="" disabled selected) Seleccione un producto
            each product in products
              option(value=product.id)= product.nombre

        .form-group
          label(for="cantidad") Cantidad
          input#cantidad(type="number", name="cantidad", required, min="1")

        .form-group
          label(for="motivo") Motivo
          input#motivo(type="text", name="motivo", required)

        .form-buttons
          button(type="submit") Registrar Salida
          a.button3(href="/stock") Cancelar
