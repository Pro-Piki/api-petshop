extends ../layouts/main

block content
  h1= title
  
  if errorMessage
    .alert.alert-danger= errorMessage
  
  form(method="POST")
    .mb-3
      label.form-label(for="idProducto") Producto
      select.form-select(name="idProducto" required)
        each product in products
          option(value=product.id)= product.nombre
    
    .mb-3
      label.form-label(for="cantidad") Cantidad
      input.form-control(type="number" name="cantidad" required min="1")
    
    .mb-3
      label.form-label(for="motivo") Motivo
      input.form-control(type="text" name="motivo" required)
    
    .mb-3
      button.btn.btn-primary(type="submit") Registrar Salida
      a.btn.btn-secondary.ms-2(href="/stock") Cancelar