extends ../layouts/main

block content
  h1= title
  
  if errorMessage
    .alert.alert-danger= errorMessage
  
  form(method="POST")
    .mb-3
      label.form-label(for="idProducto") Producto
      select.form-select(name="idProducto" required)
        each product in products
          option(value=product.id)= product.nombre
    
    .mb-3
      label.form-label(for="cantidad") Cantidad
      input.form-control(type="number" name="cantidad" required min="1")
    
    .mb-3
      label.form-label(for="proveedor") Proveedor
      input.form-control(type="text" name="proveedor" required)
    
    .mb-3
      label.form-label(for="costoUnitario") Costo Unitario
      input.form-control(type="number" name="costoUnitario" required step="0.01" min="0")
    
    .mb-3
      button.btn.btn-primary(type="submit") Registrar Ingreso
      a.btn.btn-secondary.ms-2(href="/stock") Cancelar