extends ../layouts/main

block content
  h1= title
  
  .mb-4
    a(href="/stock/ingreso" class="btn btn-success me-2") Registrar Ingreso
    a(href="/stock/salida" class="btn btn-danger") Registrar Salida
  
  if movements.length > 0
    table.table.table-striped
      thead
        tr
          th Tipo
          th Producto
          th Cantidad
          th Fecha
          th Detalle
      tbody
        each movimiento in movements
          tr
            td= movimiento.tipo === 'ingreso' ? 'Ingreso' : 'Salida'
            td= movimiento.idProducto
            td= movimiento.cantidad
            td= new Date(movimiento.fecha).toLocaleString()
            td
              if movimiento.tipo === 'ingreso'
                | Proveedor: #{movimiento.proveedor}, Costo: #{movimiento.costoUnitario}
              else
                | Motivo: #{movimiento.motivo}
  else
    .alert.alert-info No hay movimientos registrados