extends ../layouts/main

block content
  h1 Stock de Productos

  a.btn.btn-success.mb-3(href="/stock/nuevo") Registrar Movimiento

  table.table.table-bordered
    thead
      tr
        th Nombre
        th Categoría
        th Tipo Mascota
        th Stock
        th Acciones
    tbody
      each producto in productos
        tr
          td= producto.nombre
          td= producto.categoria
          td= producto.tipoMascota
          td= producto.stock
          td
            a.btn.btn-sm.btn-info(href=`/stock/${producto._id}`) Ver Movimientos
