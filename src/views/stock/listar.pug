doctype html
html
  head
    title Movimientos de Stock
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="icon" href="/images/logoHuellita.ico" type="image/x-icon")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel")
          i.fas.fa-th
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i(class="fas fa-door-open")
        <span id="contador" class="text-black ml-3" style="color: white;">Usuarios conectados: 0</span>

    .container
      .header-flex
        h1 Movimientos de Stock
        a.button(href="/stock/nuevo") Registrar Movimiento

      if successMessage
        p.success #{successMessage}
      if errorMessage
        p.error #{errorMessage}

      table.custom-table
        thead
          tr
            th Nombre
            th Categoría
            th Tipo Mascota
            th Stock
            th Acciones
        tbody
            each producto in productos
              tr
                td= producto.nombre
                td= producto.categoria
                td= producto.tipoMascota
                td= producto.stock
                td
                  a.btn.btn-sm.btn-info(href=`/stock/${producto._id}`) Ver Movimientos
    script(src="/socket.io/socket.io.js")
    script.
      const socket = io();
      socket.on('usuarios', (cantidad) => {
        const contador = document.getElementById('contador');
        if (contador) {
          contador.textContent = 'Usuarios conectados: ' + cantidad;
        }
      });