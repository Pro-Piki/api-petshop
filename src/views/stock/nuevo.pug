doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Registrar Movimiento de Stock
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/turnos.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
  
  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel")
          i.fas.fa-th
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i.fas.fa-door-open
        span#contador.text-black.ml-3(style="color: white;") Usuarios conectados: 0

    .container
      h1 Registrar Movimiento de Stock
      hr.linea-decorativa

      if errorMessage
        .error= errorMessage

      form(method="POST", action="/stock")
        .form-group
          label(for="tipo") Tipo de movimiento:
          select#tipo(name="tipo", required)
            option(value="entrada") Entrada
            option(value="salida") Salida

        .form-group
          label(for="idProducto") Producto:
          select#idProducto(name="idProducto", required)
            each producto in productos
              option(value=producto._id)= producto.nombre

        .form-group
          label(for="cantidad") Cantidad:
          input#cantidad(type="number", name="cantidad", min="1", required)

        .form-group
          label(for="proveedor") Proveedor:
          input#proveedor(type="text", name="proveedor")

        .form-group
          label(for="costoUnitario") Costo Unitario:
          input#costoUnitario(type="number", name="costoUnitario", step="0.01")

        .form-group
          label(for="motivo") Motivo:
          input#motivo(type="text", name="motivo")

        button.button(type="submit") Registrar
        a.button3(href="/stock") Volver

    script(src="/socket.io/socket.io.js")
    script.
      const socket = io();
      socket.on('usuarios', (cantidad) => {
        const contador = document.getElementById('contador');
        if (contador) {
          contador.textContent = 'Usuarios conectados: ' + cantidad;
        }
      });
