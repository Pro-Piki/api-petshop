extends ../layouts/main

block content
  h1 Movimientos de Stock

  a.btn.btn-primary.mb-3(href="/stock") Volver

  if movimientos.length
    table.table.table-striped
      thead
        tr
          th Tipo
          th Cantidad
          th Proveedor
          th Costo Unitario
          th Motivo
          th Fecha
      tbody
        each movimiento in movimientos
          tr
            td(class=movimiento.tipo === 'entrada' ? 'text-success' : 'text-danger')= movimiento.tipo
            td= movimiento.cantidad
            td= movimiento.proveedor || '-'
            td= movimiento.costoUnitario || '-'
            td= movimiento.motivo || '-'
            td= new Date(movimiento.fecha).toLocaleDateString()
  else
    p.text-muted No hay movimientos registrados.
