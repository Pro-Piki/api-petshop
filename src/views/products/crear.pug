extends ../layouts/main

block content
  h1.mb-4= title

  if errorMessage
    .alert.alert-danger= errorMessage

  form(method="POST", action="/products/crear")
    .mb-3
      label.form-label(for="nombre") Nombre
      input.form-control(type="text", id="nombre", name="nombre", required)
    
    .mb-3
      label.form-label(for="categoria") Categoría
      input.form-control(type="text", id="categoria", name="categoria", required)
    
    .mb-3
      label.form-label(for="tipoMascota") Tipo de Mascota
      input.form-control(type="text", id="tipoMascota", name="tipoMascota", required)
    
    .mb-3
      label.form-label(for="precio") Precio
      input.form-control(type="number", id="precio", name="precio", step="0.01", required)
    
    .mb-3
      label.form-label(for="stock") Stock
      input.form-control(type="number", id="stock", name="stock", required)
    
    button.btn.btn-primary(type="submit") Crear Producto