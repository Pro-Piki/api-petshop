doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Editar Producto
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/turnos.css")
    link(rel="stylesheet", href="/styles/productos.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")

  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel")
          i.fas.fa-th
        a.logout-icon(href="#", title="Cerrar sesión")
          i.fas.fa-door-open

    .container
      h1 Editar Producto
      hr.linea-decorativa

      if errorMessage
        .error= errorMessage

      form(method="POST", action=`/products/${product.id}?_method=PUT`)
        .form-group
          label(for="nombre") Nombre:
          input#nombre(type="text", name="nombre", value=product.nombre, required)

        .form-group
          label(for="categoria") Categoría:
          input#categoria(type="text", name="categoria", value=product.categoria, required)

        .form-group
          label(for="tipoMascota") Tipo de Mascota:
          input#tipoMascota(type="text", name="tipoMascota", value=product.tipoMascota, required)

        .form-group-horizontal
          .half-group
            label(for="precio") Precio:
            input#precio(type="number", name="precio", step="0.01", value=product.precio, required)

          .half-group
            label(for="stock") Stock:
            input#stock(type="number", name="stock", value=product.stock, required)

        
        button.button(type="submit") Guardar Cambios
        a.button3(href="/products") Cancelar