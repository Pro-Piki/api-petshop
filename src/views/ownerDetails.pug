doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Detalles del Cliente
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/productos.css")
    link(rel="stylesheet", href="/styles/turnos.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
  
  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/owners/register") 
          i.fas.fa-th
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i.fas.fa-door-open
        <span id="contador" class="text-black ml-3" style="color: white;">Usuarios conectados: 0</span>

    .container.detalle-producto
      h1 Detalles del Cliente
      hr.linea-decorativa

      .contenido-y-botones
        .contenido-detalle
          .card
            .card-body
              h3.card-title Información personal
              p.card-text
                strong DNI:
                |  #{owner.dni}
              p.card-text
                strong Nombre:
                |  #{owner.name}
              p.card-text
                strong Teléfono:
                |  #{owner.phone}
              p.card-text
                strong Dirección:
                |  #{owner.address}

          hr.linea-decorativa

          h3.card-title Mascotas registradas

          if pets.length
            .card
              .card-body
                table.custom1
                  thead
                    tr
                      th Nombre
                      th Tipo
                  tbody
                    each pet in pets
                      tr
                        td= pet.name
                        td= pet.type
          else
            .error No hay mascotas registradas para este cliente.

        .botones-verticales
          a.boton-general.boton-editar(href=`/owners/edit/${owner.id}`) Editar
          a.boton-general.boton-eliminar(href=`/owners/delete/${owner.id}`) Eliminar
          a.boton-general.boton-volver(href="/owners/register") Volver
  script(src="/socket.io/socket.io.js")
  script.
    const socket = io();
    socket.on('usuarios', (cantidad) => {
      const contador = document.getElementById('contador');
      if (contador) {
        contador.textContent = 'Usuarios conectados: ' + cantidad;
      }
    });
