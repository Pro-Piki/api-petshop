doctype html
html
  head
    title Detalles del Cliente
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/owners/register") 
          i.fas.fa-th
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i.fas.fa-door-open

    .container
      h1 Detalles del Cliente

      h2 Información personal
      ul
        li DNI: #{owner.dni}
        li Nombre: #{owner.name}
        li Teléfono: #{owner.phone}
        li Dirección: #{owner.address}

      h2 Mascotas registradas
      if pets.length
        table
          thead
            tr
              th Nombre
              th Tipo
          tbody
            each pet in pets
              tr
                td= pet.name
                td= pet.type
      else
        p No hay mascotas registradas para este cliente.