doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Productos'
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css")
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
      .container
        a.navbar-brand(href="/") Productos & Stock
        span.text-white#contador.ml-3 Usuarios conectados: 0

    .container
      block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js")
    script(src="/socket.io/socket.io.js")
    script.
      const socket = io();
      socket.on('usuarios', (cantidad) => {
        const contador = document.getElementById('contador');
        if (contador) {
          contador.textContent = 'Usuarios conectados: ' + cantidad;
        }
      });
