doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Editar Cliente
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/turnos.css")
    link(rel="stylesheet", href="/styles/productos.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")

  body
    .navbar
      img(src="/images/logo.png", alt="Logo")
      .nav-icons
        a.panel-icon(href="/panel")
          i.fas.fa-th
        a.logout-icon(href="/logout", title="Cerrar sesión")
          i.fas.fa-door-open
        <span id="contador" class="text-black ml-3" style="color: white;">Usuarios conectados: 0</span>

    .container
      h1 Editar Cliente
      hr.linea-decorativa

      if errorMessage
        .error= errorMessage

      form(method="POST", action=`/owners/edit/${owner._id}`)
        .form-group
          label(for="dni") DNI:
          input#dni(type="text", name="dni", required, value=owner.dni)

        .form-group
          label(for="name") Nombre:
          input#name(type="text", name="name", required, value=owner.name)

        .form-group
          label(for="phone") Teléfono:
          input#phone(type="text", name="phone", required, value=owner.phone)

        .form-group
          label(for="address") Dirección:
          input#address(type="text", name="address", required, value=owner.address)

        
        button.button(type="submit") Guardar Cambios
        a.button3(href="/owners/register") Cancelar
    script(src="/socket.io/socket.io.js")
  script.
    const socket = io();
    socket.on('usuarios', (cantidad) => {
      const contador = document.getElementById('contador');
      if (contador) {
        contador.textContent = 'Usuarios conectados: ' + cantidad;
      }
    });